{
  "id": "animes-es",
  "name": "AnimES",
  "version": "1.7.6",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Anime en español, doblado o subtitulado, desde AnimeAV1, Henaojara, TioAnime y Latanime. Catálogo y enlaces del addon AnimES de Pigamer37.",
  "author": "xuper-plugin",
  "homepage": "https://pigamer37.alwaysdata.net/onAirCatalogs=animeav1%2Chenaojara%2Ctioanime%2Clatanime/manifest.json",
  "hosts": [
    "pigamer37.alwaysdata.net",
    "animeav1.com",
    "player.zilla-networks.com"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "scopedSearch",
    "download",
    "screen"
  ],
  "streamHosts": "any",
  "categories": [
    "anime",
    "series"
  ],
  "color": "#FF8A3D",
  "section": {
    "label": "AnimES"
  },
  "theme": {
    "accent": "#FF8A3D",
    "onAccent": "#1F0F05",
    "background": "#0D0A08",
    "surface": "#1A1410",
    "highlight": "#FFD3A8"
  },
  "telemetry": true,
  "settings": [
    {
      "key": "audioSection",
      "type": "section",
      "label": "Audio",
      "hint": "Qué versión se reproduce primero; la otra queda en el menú de servidores."
    },
    {
      "key": "audio",
      "type": "select",
      "label": "Audio preferido",
      "default": "sub",
      "options": [
        {
          "value": "sub",
          "label": "Subtitulado (audio original)"
        },
        {
          "value": "dub",
          "label": "Doblado"
        }
      ]
    },
    {
      "key": "srcSection",
      "type": "section",
      "label": "Fuentes",
      "hint": "Activa o desactiva cada sitio de anime."
    },
    {
      "key": "src_animeav1",
      "type": "toggle",
      "label": "AnimeAV1",
      "default": true
    },
    {
      "key": "src_henaojara",
      "type": "toggle",
      "label": "Henaojara",
      "default": true
    },
    {
      "key": "src_tioanime",
      "type": "toggle",
      "label": "TioAnime",
      "default": true
    },
    {
      "key": "src_latanime",
      "type": "toggle",
      "label": "Latanime",
      "default": true
    },
    {
      "key": "hls",
      "type": "toggle",
      "label": "Copia HLS de AnimeAV1",
      "default": true,
      "hint": "Más rápida y estable; aparece en el menú de servidores."
    },
    {
      "key": "voe",
      "type": "toggle",
      "label": "Copia Voe (respaldo)",
      "default": true,
      "hint": "Segunda opción rápida; se abre solo si la eliges o si no hay otra."
    },
    {
      "key": "homeSection",
      "type": "section",
      "label": "Inicio"
    },
    {
      "key": "homeRows",
      "type": "toggle",
      "label": "Filas en Inicio",
      "default": true,
      "hint": "El anime en emisión de cada fuente aparece en el Inicio de Kino."
    },
    {
      "key": "toolsSection",
      "type": "section",
      "label": "Herramientas"
    },
    {
      "key": "health",
      "type": "status",
      "label": "Estado de las fuentes"
    },
    {
      "key": "cache",
      "type": "status",
      "label": "Caché"
    },
    {
      "key": "probe",
      "type": "action",
      "label": "Comprobar fuentes"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "confirm": "¿Vaciar la caché de listas y episodios?"
    }
  ],
  "debug": true,
  "fetchHosts": "any",
  "screen": {
    "label": "AnimES",
    "labelEn": "AnimES",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir AnimES",
      "labelEn": "Open AnimES"
    },
    "settingsIn": "both"
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "b4547b33901c6dd9dae6a13bc18c10db9bc8766f3dc56c78fc4af613beae90743e3c9e4cf0a043becdf4d6bfeae1b13c1aadaac047b87c43fda98abdadb83a04"
  }
}
